<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="miniarm_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <link name="world"/>
        <joint name="fixed" type="fixed">
            <parent link="world"/>
            <child link="base_link"/>
        </joint>
        
        <ros2_control name="GazeboSystem" type="system">
            <hardware>
              <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
    
            <joint name="yaw_link">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['yaw_link']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="p1_link">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['p1_link']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="p2_link">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['p2_link']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="roll_link">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['roll_link']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="minip_link">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['minip_link']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="minir_link">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['minir_link']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
        <gazebo>
          <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
              <parameters>$(find miniarm)/config/ros2_controllers.yaml</parameters>
              <robot_param>robot_description</robot_param>
              <robot_param_node>robot_state_publisher</robot_param_node>
          </plugin>
        </gazebo>
        
    </xacro:macro>
</robot>
